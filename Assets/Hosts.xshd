<?xml version="1.0"?>
<SyntaxDefinition name="Hosts" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Default" foreground="#E8EBF4" />
  <Color name="Comment" foreground="#9AA5BE" fontStyle="italic" />
  <Color name="Address" foreground="#FFB347" />
  <Color name="Host" foreground="#8FD460" />

  <RuleSet ignoreCase="true">
    <Rule color="Comment">\#.*</Rule>
    <Rule color="Address">(?:\d{1,3}\.){3}\d{1,3}</Rule>
    <Rule color="Address">[0-9A-Fa-f]{1,4}(?::[0-9A-Fa-f]{0,4}){2,}</Rule>
    <Rule color="Host">(?:[A-Za-z0-9](?:[A-Za-z0-9\-]*[A-Za-z0-9])?\.)+[A-Za-z]{2,}</Rule>
  </RuleSet>
</SyntaxDefinition>
