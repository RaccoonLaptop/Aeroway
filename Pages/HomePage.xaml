<UserControl x:Class="ZapretUI.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel x:Name="AboveStrip"/>
            <Border x:Name="StripViewport"
                    Width="504"
                    Height="72"
                    HorizontalAlignment="Center"
                    Background="Transparent"
                    ClipToBounds="True"
                    SnapsToDevicePixels="True"
                    PreviewMouseWheel="StripViewport_MouseWheel">
                <Canvas Height="72" ClipToBounds="False">
                    <ItemsControl x:Name="StrategyStrip" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="156"
                                        Height="56"
                                        Margin="6,8"
                                        CornerRadius="14"
                                        Cursor="Hand"
                                        SnapsToDevicePixels="True"
                                        MouseEnter="Card_MouseEnter"
                                        MouseLeave="Card_MouseLeave"
                                        MouseLeftButtonUp="Card_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CardSelectedBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1.5"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Border BorderBrush="{DynamicResource CardHoverBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Opacity="0"
                                                IsHitTestVisible="False"/>
                                        <TextBlock Text="{Binding Title}"
                                                   Margin="12,0"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   FontSize="13">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Border>
            <StackPanel x:Name="BelowStrip"/>
        </StackPanel>
    </Grid>
</UserControl>
